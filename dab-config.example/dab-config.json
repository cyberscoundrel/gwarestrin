{
  "$schema": "https://github.com/Azure/data-api-builder/releases/latest/download/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "Server=host.docker.internal,1433;Database=mydb;User Id=myuser;Password=CHANGEME;TrustServerCertificate=True"
  },
  "autoentities": {
    "all-tables-mydb": {
      "patterns": {
        "include": ["dbo.%"],
        "name": "{schema}_{object}"
      },
      "template": {
        "mcp": { "dml-tools": true },
        "rest": { "enabled": false },
        "graphql": { "enabled": false }
      },
      "permissions": [{ "role": "anonymous", "actions": [{ "action": "read" }] }]
    }
  },
  "data-source-files": ["/etc/dab/dab-config-otherdb.json"],
  "runtime": {
    "rest": { "enabled": false },
    "graphql": { "enabled": false },
    "host": {
      "mode": "development",
      "authentication": { "provider": "Simulator" }
    },
    "mcp": {
      "description": "Local SQL Server databases via Microsoft SQL MCP Server (Data API builder). Entities are auto-exposed per database; use describe_entities to discover them, then read_records / aggregate_records. Read-only: nothing can be created, changed or deleted."
    }
  }
}
