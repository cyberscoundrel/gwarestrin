# Copy to .env (gitignored) on the deploy host and populate.
# Only keys referenced by providers.json "apiKeyEnv" (or first-party defaults)
# need to be present; missing ones simply mark that provider keyless.

# --- first-party hosted providers (auto-registered when present) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- custom providers referenced from providers.json ---
# ZAI_API_KEY=
# CLUSTER_API_KEY=
# HOMELAB_VLLM_KEY=

# --- server tuning (optional) ---
# PORT=3000
# GWARESTRIN_MAX_AGENTS=4
# GWARESTRIN_LOG=info
