{
  "name": "gwarestrin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-agent web console: pi agents sandboxed in gondolin microvms",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @gwarestrin/server",
    "dev:web": "npm run dev -w @gwarestrin/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
