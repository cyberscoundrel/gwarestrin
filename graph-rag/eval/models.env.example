# The real-model run's models and keys (graph-rag/eval/run.sh --models real --env-file <this file>).
# Copy to ~/gwsynth-models.env on the host, fill in the values yourself, and keep it private (chmod 600).
# No assistant reads, prints or types these values: the run passes the file by path to docker's --env-file.
#
# The run talks only to the synthetic test database (invented rows), which stands in for R11.15 (still open).

# Agents (the orchestrator and its workers): any OpenAI-compatible endpoint with tool calls.
# OpenRouter lets one key reach several providers' models, which is what comparing setups needs.
EVAL_AGENT_BASE_URL=https://openrouter.ai/api/v1
EVAL_AGENT_API_KEY=

# Setup A and setup B: one orchestrator model and one worker model each (model ids as the endpoint names them).
EVAL_SETUP_A_ORCHESTRATOR=
EVAL_SETUP_A_WORKER=
EVAL_SETUP_B_ORCHESTRATOR=
EVAL_SETUP_B_WORKER=

# The typed check (R4): a decision model with real probabilities, read by graph-rag itself.
# The default endpoint and model are OpenRouter's decisions API and Jev; its key may be the same OpenRouter key.
DECISION_API_KEY=
# DECISION_URL=https://openrouter.ai/api/alpha/decisions
# DECISION_MODEL=~typesafe/jev-latest
