# The real-model run's key and models (graph-rag/eval/run.sh --models real --env-file ~/gwsynth-models.env --setup A).
# Copy to ~/gwsynth-models.env on the host, fill in the key yourself, and keep it private (chmod 600).
# No assistant reads, prints or types these values: the run passes the file by path to docker.
# The run talks only to the synthetic test database (invented rows), which stands in for R11.15 (still open).

# Your OpenRouter key: the one place it goes. The run's own litellm (same image and committed configuration as the
# repository's) reaches the models with it, and the typed check's decision model (Jev on OpenRouter) uses it too.
OPENROUTER_API_KEY=

# Two setups, an orchestrator model and a worker model each: aliases from litellm-config.example/litellm-config.yaml.
EVAL_SETUP_A_ORCHESTRATOR=deepseek-v4-flash
EVAL_SETUP_A_WORKER=deepseek-v4-flash
EVAL_SETUP_B_ORCHESTRATOR=
EVAL_SETUP_B_WORKER=

# Optional.
# A separate key for the decision model, if it isn't the OpenRouter key above:
# DECISION_API_KEY=
# DECISION_URL=https://openrouter.ai/api/alpha/decisions
# DECISION_MODEL=~typesafe/jev-latest
# Without litellm (run.sh --via direct): any OpenAI-compatible endpoint, with the setups naming its own model ids.
# EVAL_AGENT_BASE_URL=https://openrouter.ai/api/v1
# EVAL_AGENT_API_KEY=
