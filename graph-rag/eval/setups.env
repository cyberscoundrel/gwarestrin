# The evaluation's setups by name: litellm aliases from litellm-config.example/litellm-config.yaml. No keys here;
# run.sh reads a setup's names from the user's env file when it sets them, else from this file.
EVAL_SETUP_A_ORCHESTRATOR=deepseek-v4-flash
EVAL_SETUP_A_WORKER=deepseek-v4-flash
EVAL_SETUP_B_ORCHESTRATOR=nemotron-3.5-lightning
EVAL_SETUP_B_WORKER=nemotron-3.5-lightning
# GLM 5.3 Flash (z-ai/glm-5.3-flash), the third setup, on a subset of the notes (the coordinator, 2026-11-11)
EVAL_SETUP_C_ORCHESTRATOR=glm-5.3-flash
EVAL_SETUP_C_WORKER=glm-5.3-flash
